# GÉNÉRÉ par theme/apply.sh — ne pas éditer le fichier généré
# Modifier ce template (theme/templates/starship/.config/starship.toml.tmpl)

"$schema" = 'https://starship.rs/config-schema.json'

palette = "michka"

[palettes.michka]
text   = "#{{fg}}"
muted  = "#{{muted}}"
accent = "#{{accent}}"
error  = "#{{error}}"

[character]
success_symbol = "[❯](bold text)"
error_symbol   = "[❯](bold error)"
vimcmd_symbol  = "[❮](bold accent)"

[directory]
style             = "bold text"
truncation_length = 3
truncation_symbol = "…/"
read_only         = " "
read_only_style   = "error"

[git_branch]
symbol = " "
style  = "accent"
format = "[$symbol$branch]($style) "

[git_status]
style      = "accent"
format     = '([\[$all_status$ahead_behind\]]($style) )'
conflicted = "="
ahead      = "⇡${count}"
behind     = "⇣${count}"
diverged   = "⇕"
untracked  = "?${count}"
stashed    = "*${count}"
modified   = "!${count}"
staged     = "+${count}"
renamed    = "»${count}"
deleted    = "✘${count}"

[cmd_duration]
min_time = 500
style    = "muted"
format   = "[ $duration]($style)"

[username]
show_always = false
style_user  = "bold text"
style_root  = "bold error"
format      = "[$user]($style)"

[hostname]
ssh_only = true
style    = "accent"
format   = "[@$hostname]($style) "

# ── Langages & outils : comportement no-empty-icons + versions en gris ──
