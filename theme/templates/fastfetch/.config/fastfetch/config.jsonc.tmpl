// GÉNÉRÉ par theme/apply.sh — modifier theme/templates/fastfetch/.config/fastfetch/config.jsonc.tmpl
// Tout en couleur d'accent (truecolor ANSI 38;2;R;G;B, indépendant des couleurs du terminal)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "padding": { "top": 1 },
    // logo entièrement en accent (on force tous les slots de couleur)
    "color": { "1": "38;2;{{accent_r}};{{accent_g}};{{accent_b}}", "2": "38;2;{{accent_r}};{{accent_g}};{{accent_b}}", "3": "38;2;{{accent_r}};{{accent_g}};{{accent_b}}" }
  },
  "display": {
    "color": {
      "keys": "38;2;{{accent_r}};{{accent_g}};{{accent_b}}",     // OS, Kernel, ...
      "title": "38;2;{{accent_r}};{{accent_g}};{{accent_b}}",    // michka@michkasarchlinux
      "output": "38;2;{{accent_r}};{{accent_g}};{{accent_b}}"    // les valeurs (Arch Linux x86_64, etc.)
    },
    "percent": {
      // supprime le vert/jaune des pourcentages d'usage → accent partout
      "color": { "green": "38;2;{{accent_r}};{{accent_g}};{{accent_b}}", "yellow": "38;2;{{accent_r}};{{accent_g}};{{accent_b}}", "red": "38;2;{{accent_r}};{{accent_g}};{{accent_b}}" }
    }
  }
}
