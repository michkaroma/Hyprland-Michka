# GÉNÉRÉ par theme/apply.sh — ne pas éditer
# Couleurs : theme/palette.sh — reste de la config : theme/templates/dunst/.config/dunst/dunstrc.tmpl

[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = (10, 40)
    width = 350
    font = CaskaydiaCove Nerd Font 11
    padding = 10
    horizontal_padding = 10
    frame_width = 1
    corner_radius = 8
    frame_color = "#ff0000"
    separator_color = frame

[urgency_low]
    background = "#000000"
    foreground = "#bfbfbf"
    frame_color = "#333333"
    timeout = 5

[urgency_normal]
    background = "#000000"
    foreground = "#ffffff"
    timeout = 8

[urgency_critical]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#ff0000"
    timeout = 0
